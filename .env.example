# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Mode -------------------------------------------------------------------
# A domain whose wildcard record (*.example.com) points at this box: golem lives at
# golem.<domain>, projects at <slug>.<domain>. Local: localhost (no DNS needed).
BASE_DOMAIN=
# GitHub org that holds the project repos and their ghcr.io images.
GITHUB_ORG=
# Local mode only: bootstrap adds COMPOSE_FILE=compose.yml:compose.local.yml (plain
# HTTP on EDGE_PORT, no certificates), and EDGE_PORT is its host port (8800).
EDGE_PORT=

# --- Harness ----------------------------------------------------------------
# claude or fake
HARNESS=claude
# What new projects get unless the dictation or a command says otherwise.
# Modes: reckless, standard, rigorous. Models: fable, opus, sonnet, haiku.
# Effort: low, medium, high, xhigh, max.
GOLEM_DEFAULT_MODE=standard
GOLEM_MODEL=opus
GOLEM_EFFORT=high
# Password for signing in to the web app. Required, no default: signed in, the web app
# can do everything, deleting projects included. Pick a long one.
GOLEM_WEB_PASSWORD=
# Memory cap for the golem container: the service and every worker it runs.
GOLEM_MEM_LIMIT=1536m
# From `claude setup-token` (one-year token for your subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# Workers' token. Fine-grained, resource owner GITHUB_ORG, all repositories:
# repository creation, plus Contents, Pull requests, Issues and Workflows read and write,
# and Actions read-only (golem reads CI before merging and deploying).
GOLEM_GITHUB_TOKEN=

# --- Deployer ---------------------------------------------------------------
# Shared secret golem sends in the X-Deployer-Secret header. `openssl rand -hex 32`.
DEPLOYER_SECRET=
# A second secret, only for deleting a project's data (!delete, bin/nuke.sh).
# Workers never get it. Empty turns deleting off. Bootstrap generates it.
DEPLOYER_ADMIN_SECRET=
# github (fetch from the org) or local (fetch from bare repos in the git-source volume)
DEPLOYER_GIT_SOURCE=github
# Fine-grained, resource owner GITHUB_ORG, all repositories, read-only: Contents and Actions.
DEPLOYER_GITHUB_TOKEN=
# ghcr.io only accepts classic tokens: a classic token with just read:packages,
# and the GitHub username that owns it.
DEPLOYER_REGISTRY_USER=
DEPLOYER_REGISTRY_TOKEN=
# true on a server. Local mode has no CI, so false.
DEPLOYER_REQUIRE_CHECKS=true
# Memory caps in MB.
DEPLOYER_SERVICE_MEM_CAP_MB=512
DEPLOYER_PROJECT_MEM_CAP_MB=1024
